@page
@model WLVSSeatSync.Web.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Log in";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <h1 class="h3 mb-3">Log in</h1>

        @if (Model.ErrorMessage is not null)
        {
            <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
        }

        <form method="post">
            <input type="hidden" asp-for="ReturnUrl" />
            <div class="mb-3">
                <label asp-for="Input.Email" class="form-label"></label>
                <input asp-for="Input.Email" class="form-control" autocomplete="email" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.Password" class="form-label"></label>
                <input asp-for="Input.Password" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary w-100">Log in</button>
        </form>

        @if (Model.GoogleEnabled)
        {
            <form method="post" asp-page-handler="Google" class="mt-3">
                <input type="hidden" asp-for="ReturnUrl" />
                <button type="submit" class="btn btn-outline-dark w-100">Continue with Google</button>
            </form>
        }

        <p class="mt-3 small text-body-secondary">Demo account: attendee@seatsync.dev / Passw0rd!</p>
        <p>New here? <a asp-page="/Account/Register" asp-route-returnUrl="@Model.ReturnUrl">Create an account</a></p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}