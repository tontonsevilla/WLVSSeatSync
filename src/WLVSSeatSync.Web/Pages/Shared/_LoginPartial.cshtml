<ul class="navbar-nav">
    @if (User.Identity?.IsAuthenticated == true)
    {
        <li class="nav-item"><a class="nav-link" asp-page="/Account/Tickets">My tickets</a></li>
        <li class="nav-item"><span class="nav-link text-body-secondary">@User.Identity.Name</span></li>
        <li class="nav-item">
            <form method="post" asp-page="/Account/Logout">
                <button type="submit" class="btn btn-link nav-link">Log out</button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item"><a class="nav-link" asp-page="/Account/Login">Log in</a></li>
        <li class="nav-item"><a class="nav-link" asp-page="/Account/Register">Sign up</a></li>
    }
</ul>