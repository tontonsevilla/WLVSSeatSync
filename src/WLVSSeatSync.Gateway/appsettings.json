{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "api": {
        "ClusterId": "api",
        "Match": { "Path": "/api/{**rest}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "hubs": {
        "ClusterId": "api",
        "Match": { "Path": "/hubs/{**rest}" }
      },
      "web": {
        "ClusterId": "web",
        "Order": 100,
        "Match": { "Path": "{**rest}" },
        "Transforms": [ { "RequestHeaderOriginalHost": "true" } ]
      }
    },
    "Clusters": {
      "api": { "Destinations": { "primary": { "Address": "https+http://api" } } },
      "web": { "Destinations": { "primary": { "Address": "https+http://web" } } }
    }
  },
  "AllowedHosts": "*"
}
